  "composite": {
    "$comment": "No endpoint grants or revokes a USER role: the only grant/revoke paths in the spec are for SQL privileges. Roles are a whole-array replace on PUT /v2/security/user, so these two are read-modify-write composites and carry a lost-update risk. Declared here, implemented by hand, NOT generated.",
    "security.user.grantRole": {
      "category": "security",
      "title": "Grant a role to a user",
      "mutating": true,
      "privilege": "%Admin_Secure:U",
      "steps": [
        "GET /v2/security/user?name=",
        "add role to result.Roles",
        "PUT /v2/security/user?name="
      ],
      "risk": "lost update - concurrent edits to the same user overwrite each other",
      "preCheck": "roleExists"
    },
    "security.user.revokeRole": {
      "category": "security",
      "title": "Revoke a role from a user",
      "mutating": true,
      "privilege": "%Admin_Secure:U",
      "steps": [
        "GET /v2/security/user?name=",
        "remove role from result.Roles",
        "PUT /v2/security/user?name="
      ],
      "risk": "lost update - concurrent edits to the same user overwrite each other",
      "preCheck": "roleExists"
    }
  },
