# IRIS image (portal targets 2026.2)
IRIS_IMAGE=intersystemsdc/irishealth-community:2026.2

# Host port for the IRIS web server (Management Portal + /api/admin + the portal)
IRIS_PORT=52773

# Password set for _SYSTEM during build
IRIS_PASSWORD=SYS

# Password for set admin
IRIS_ADMIN_USER=docket
IRIS_ADMIN_PASSWORD=12345

# Agent console.
# "mock" replays a deterministic scenario and needs no API key - the full flow, refusals included, has to be visible without one
# "live" goes to OpenRouter (one endpoint, OpenAI-shaped, any model behind it) and needs a key
# without a key the console stays in mock whatever this says
LLM_MODE=mock
OPENROUTER_API_KEY=
# Default: anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=
# Comma-separated models the agent console can switch between. Empty: Claude, GPT, Gemini, Llama
OPENROUTER_MODELS=
